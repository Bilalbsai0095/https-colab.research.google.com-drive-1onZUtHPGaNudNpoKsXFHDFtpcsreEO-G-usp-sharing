        self.age = age
        self.course = course

    def display(self):
        print("Name:", self.name)
        print("Age:", self.age)
        print("Course:", self.course)

class Graduate:
    def __init__(self, name, age, course, research):
        self.name = name
        self.age = age
        self.course = course
        self.research = research

    def display(self):
        print("Name:", self.name)
        print("Age:", self.age)
        print("Course:", self.course)
        print("Research:", self.research)

def show(obj):
    obj.display()

s1 = Student("Ahmed", 20, "Computer Science")
g1 = Graduate("Ali", 22, "Computer Science", "Artificial Intelligence")

show(s1)
