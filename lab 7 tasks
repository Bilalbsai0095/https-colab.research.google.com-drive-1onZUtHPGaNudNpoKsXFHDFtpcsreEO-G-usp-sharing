class Student:
    def __init__(self, name, age, course):
        self.name = name
        self.age = age
        self.course = course

    def display(self):
        print("Name", self.name)
        print("Age", self.age)
        print("Course", self.course)

s1 = Student("Ali", 20, "Python")
s1.display()


